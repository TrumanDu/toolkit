{
  "name": "Toolkit",
  "version": "0.1.5",
  "description": "A toolkit for scalable desktop apps",
  "keywords": [
    "electron",
    "react",
    "typescript",
    "vite",
    "hot",
    "reload"
  ],
  "license": "MIT",
  "author": {
    "name": "TrumanDu",
    "url": "https://www.trumandu.top"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build && rm -rf release/app/out && cp -r out release/app/out",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "package": "npm run build && electron-builder build --publish never",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "test": "jest"
  },
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/__tests__/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "testEnvironment": "jsdom",
    "setupFiles": [
      "./src/__tests__/setup.js"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      "release/app/out"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx,js,jsx}"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-router|react-router-dom|@remix-run|@ant-design|antd|rc-|@rc-component)/)"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.web.json"
        }
      ]
    }
  },
  "dependencies": {
    "@nostar/baidu-analytics-electron": "^1.0.7",
    "antd": "^6.5.1",
    "axios": "^1.18.1",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "fix-path": "^4.0.0",
    "portfinder": "^1.0.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^4.3.1",
    "chalk": "^4.1.2",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.49.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-erb": "^4.1.0-0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-compat": "^4.2.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.3",
    "rimraf": "^6.1.3",
    "sass": "^1.101.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.2"
  },
  "build": {
    "productName": "Toolkit",
    "appId": "top.trumandu.Toolkit",
    "asar": true,
    "asarUnpack": "**/*.{node,dll}",
    "files": [
      "out",
      "node_modules",
      "package.json"
    ],
    "mac": {
      "sign": "scripts/notarize.js",
      "notarize": false,
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "TrumanDu",
      "releaseType":"release",
      "repo": "toolkit"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=18.x"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=9.x"
    }
  }
}
